  // the impact site. Run with:
  //   dotnet run --project src/OpenSage.Tools.TestHarness -- --headless \
  //     --built-in-scenario ScenarioCapture --scenario capture-scud-missile.json
  "Name": "scud-missile",
  "MapPath": "maps/alpine assault/alpine assault.map",
  "DurationFrames": 230,

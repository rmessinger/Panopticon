// ReplaySketch Scenario Profile — Alpine Assault: USA vs GLA
// ===========================================================
//
// This file drives the default functional test and the ReplaySketch tool.
// Edit it to add, remove, or reorder actions without touching C# code.
//
// ─── HOW TIMING WORKS ───────────────────────────────────────────────────────
//
// Each action's "timing" is a frame OFFSET from the previous action
// (or from game start for the first action).
// Generals runs logic at 30 fps, so 150 frames ≈ 5 seconds of game time.
//
//   timing.kind = "fixed"
//     Fires at exactly `frames` after the prior action.
//     { "kind": "fixed", "frames": 300 }
//
//   timing.kind = "random"
//     Fires at a uniformly-random frame in the interval [minFrames, maxFrames].
//     { "kind": "random", "minFrames": 100, "maxFrames": 200 }
//
//   timing.kind = "afterActionCompleted"
//     Does NOT write this action to the pre-baked replay.  Instead the test harness
//     injects it at runtime when the specified triggerAction's ActionCompleted event
//     fires (optionally delayed by extraFrames logic frames).
//     { "kind": "afterActionCompleted", "triggerAction": "Construct", "extraFrames": 0 }
//
// ─── POSITION KINDS ──────────────────────────────────────────────────────────
//
// Omit "position" (or set it to null) for actions that don't target a map
// point (e.g. GatherResources, RecruitBasicUnit).
//
//   position.kind = "landmarkRelative"
//     Polar offset from a named anchor point on the map.
//
//     landmark values:
//       "OwnBase"   — the player's own Player_N_Start waypoint
//       "EnemyBase" — the opponent's Player_N_Start waypoint
//       "MapCenter" — midpoint of the playable map extents
//
//     distanceInBaseWidths: distance from the landmark expressed as multiples of
//       the scenario's `baseRadiusWorldUnits` (default 120 world units).
//
//     angle.kind = "fixed"   → { "kind": "fixed",  "degrees": 45.0 }
//     angle.kind = "random"  → { "kind": "random", "minDegrees": 150.0, "maxDegrees": 210.0 }
//     Angles are in degrees, measured counter-clockwise from east (0° = east, 90° = north).
//
//   position.kind = "normalized"
//     Raw 0–1 fractions of the playable map extents.
//     normX=0 is the west edge, normX=1 is the east edge.
//     normY=0 is the south edge, normY=1 is the north edge.
//     { "kind": "normalized", "normX": 0.5, "normY": 0.5 }
//
// ─── ACTION TYPES ────────────────────────────────────────────────────────────
//
//   "Construct"        — issues a build order for the specified building definition
//                        (set via "buildingDefinitionName", e.g. "AmericaBarracks")
//                        at the given position near the Command Center
//   "GatherResources"  — sends the starting supply truck to the nearest supply node
//                        (no position required)
//   "RecruitBasicUnit" — queues one infantry unit at the barracks
//                        (Ranger for USA, Rebel for GLA; no position required)
//   "AttackEnemyBase"  — issues a force-attack-ground order at the given position
//                        near the enemy Command Center
//
// ─── PLAYER SLOT FIELDS ──────────────────────────────────────────────────────
//
//   factionIndex: index into the game's PlayerTemplates list
//     USA = 2, GLA = 4 (Generals defaults)
//
//   color: slot color index (0-based, matches the in-game color picker order)
//
//   startPosition: 1-based start position matching Player_N_Start waypoints
//
//   team: 1-based team number (players on the same team are allies)
//
{
  "mapPath": "maps/alpine assault/alpine assault.map",

  // World-unit radius used as "1 base width" for landmark-relative positions.
  // Roughly the footprint radius of a Command Center (~120 world units).
  "baseRadiusWorldUnits": 120.0,

  "players": [
    {
      "name": "Player1",
      "factionIndex": 2,
      "color": 0,
      "startPosition": 1,
      "team": 1,
      "actions": [
        {
          "id": "a001",
          "label": "Build Barracks",
          "type": "Construct",
          "buildingDefinitionName": "AmericaBarracks",
          // Issues the build order at frame 90 (3 s at 30 fps) — enough time for the
          // game to initialise without needlessly delaying the scenario.
          "timing": { "kind": "fixed", "frames": 90 },
          "position": {
            "kind": "landmarkRelative",
            "landmark": "OwnBase",
            "distanceInBaseWidths": 2.0,
            "angle": { "kind": "fixed", "degrees": 225.0 }
          }
        },
        {
          "id": "a002",
          "label": "Gather Resources",
          "type": "GatherResources",
          // Deferred: fires as soon as the Construct order is dispatched (i.e. construction
          // starts), so the supply truck begins collecting resources immediately rather than
          // waiting for the barracks to finish.
          "timing": { "kind": "afterAction", "triggerActionId": "a001", "triggerPhase": "Dispatched", "extraFrames": 0 },
          "position": null
        },
        {
          "id": "a003",
          "label": "Recruit Ranger",
          "type": "RecruitBasicUnit",
          "unitDefinitionName": "AmericaInfantryRanger",
          // Deferred: fires only after the barracks finishes construction, preventing the
          // recruit order from arriving while the building is still being built.
          // Queues 5 Rangers (see ReplayExporter) — each unit that exits will re-trigger
          // AttackEnemyBase so all units are sent to attack together.
          "timing": { "kind": "afterAction", "triggerActionId": "a001", "triggerPhase": "Completed", "extraFrames": 0 },
          "position": null
        },
        {
          "id": "a004",
          "label": "Attack Enemy Base",
          "type": "AttackEnemyBase",
          // Deferred: fires after the ranger exits the barracks (RecruitBasicUnit completed).
          "timing": { "kind": "afterAction", "triggerActionId": "a003", "triggerPhase": "Completed", "extraFrames": 0 },
          "position": {
            "kind": "landmarkRelative",
            "landmark": "EnemyBase",
            // Target the waypoint directly (0 = at the CC) so auto-engage fires point-blank.
            "distanceInBaseWidths": 0.0,
            "angle": { "kind": "fixed", "degrees": 0.0 }
          }
        }
      ]
    },
    {
      "name": "Player2",
      "factionIndex": 4,
      "color": 1,
      "startPosition": 2,
      "team": 2,
      "actions": [
        {
          "id": "b001",
          "label": "Build Barracks",
          "type": "Construct",
          "buildingDefinitionName": "GLABarracks",
          "timing": { "kind": "fixed", "frames": 90 },
          "position": {
            "kind": "landmarkRelative",
            "landmark": "OwnBase",
            "distanceInBaseWidths": 2.0,
            "angle": { "kind": "fixed", "degrees": 45.0 }
          }
        },
        {
          "id": "b002",
          "label": "Gather Resources",
          "type": "GatherResources",
          // Deferred: fires as soon as the Construct order is dispatched (i.e. construction
          // starts), so the supply truck begins collecting resources immediately rather than
          // waiting for the barracks to finish.
          "timing": { "kind": "afterAction", "triggerActionId": "b001", "triggerPhase": "Dispatched", "extraFrames": 0 },
          "position": null
        },
        {
          "id": "b003",
          "label": "Recruit Rebel",
          "type": "RecruitBasicUnit",
          "unitDefinitionName": "GLAInfantryRebel",
          // Deferred: fires only after the barracks finishes construction.
          // Queues 5 Rebels (see ReplayExporter) — each unit that exits will re-trigger
          // AttackEnemyBase so all units are sent to attack together.
          "timing": { "kind": "afterAction", "triggerActionId": "b001", "triggerPhase": "Completed", "extraFrames": 0 },
          "position": null
        },
        {
          "id": "b004",
          "label": "Attack Enemy Base",
          "type": "AttackEnemyBase",
          // Deferred: fires after the rebel exits the barracks (RecruitBasicUnit completed).
          "timing": { "kind": "afterAction", "triggerActionId": "b003", "triggerPhase": "Completed", "extraFrames": 0 },
          "position": {
            "kind": "landmarkRelative",
            "landmark": "EnemyBase",
            // Target the waypoint directly (0 = at the CC) so auto-engage fires point-blank.
            "distanceInBaseWidths": 0.0,
            "angle": { "kind": "fixed", "degrees": 0.0 }
          }
        }
      ]
    }
  ]
}

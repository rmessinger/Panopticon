<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OpenSage.Tools.WorldBuilder.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="BackgroundColor">#1E1E1E</Color>
            <Color x:Key="SurfaceColor">#2D2D2D</Color>
            <Color x:Key="PrimaryColor">#569CD6</Color>
            <Color x:Key="TextColor">#D4D4D4</Color>
            <Color x:Key="TextDisabledColor">#808080</Color>
            <Color x:Key="ErrorColor">#F44747</Color>
            <Color x:Key="SuccessColor">#4EC9B0</Color>
            <Color x:Key="BorderColor">#3F3F46</Color>
            <Color x:Key="ToolbarColor">#252526</Color>

            <!-- Compact flat toolbar buttons -->
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#333, Dark=#D4D4D4}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="HeightRequest" Value="28" />
                <Setter Property="MinimumWidthRequest" Value="28" />
                <Setter Property="CornerRadius" Value="3" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

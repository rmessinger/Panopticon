<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OpenSage.Tools.WorldBuilder.Maui.Views.MapSettingsPage"
             Title="Map Settings"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#252525}">

    <Grid RowDefinitions="*,Auto" Padding="24">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16">

                <Label Text="Map Settings" FontSize="18" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#D4D4D4}" />

                <Border BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#2D2D2D}"
                        Stroke="{AppThemeBinding Light=#DDD, Dark=#3F3F46}"
                        Padding="16" StrokeShape="RoundRectangle 6">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Display Name" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
                        <Entry x:Name="MapNameEntry" Placeholder="Map display name"
                               BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#333}" />

                        <Label Text="Author" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
                        <Entry x:Name="MapAuthorEntry" Placeholder="Your name"
                               BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#333}" />

                        <Label Text="Description" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
                        <Editor x:Name="MapDescEditor" HeightRequest="80"
                                Placeholder="Brief map description"
                                BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#333}" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#2D2D2D}"
                        Stroke="{AppThemeBinding Light=#DDD, Dark=#3F3F46}"
                        Padding="16" StrokeShape="RoundRectangle 6">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Weather" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
                        <Picker x:Name="WeatherPicker"
                                Title="Select weather"
                                BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#333}"
                                TextColor="{AppThemeBinding Light=#333, Dark=#CCC}">
                            <Picker.Items>
                                <x:String>Normal</x:String>
                                <x:String>Snowy</x:String>
                                <x:String>Cloudy</x:String>
                            </Picker.Items>
                        </Picker>

                        <Label Text="Time of Day" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
                        <Picker x:Name="TimeOfDayPicker"
                                Title="Select time of day"
                                BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#333}"
                                TextColor="{AppThemeBinding Light=#333, Dark=#CCC}">
                            <Picker.Items>
                                <x:String>Morning</x:String>
                                <x:String>Afternoon</x:String>
                                <x:String>Evening</x:String>
                                <x:String>Night</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,12,*" Margin="0,16,0,0">
            <Button Grid.Column="0" Text="Cancel" Clicked="OnCancel"
                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                    TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
            <Button Grid.Column="2" Text="Apply" Clicked="OnApply"
                    BackgroundColor="#007ACC" TextColor="White" />
        </Grid>
    </Grid>
</ContentPage>

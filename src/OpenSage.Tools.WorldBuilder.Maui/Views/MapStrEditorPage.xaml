<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OpenSage.Tools.WorldBuilder.Maui.Views.MapStrEditorPage"
             Title="Map String Table (map.str)"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#252525}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16">

        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,8">
            <Label Text="Map String Table" FontSize="18" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#D4D4D4}" />
            <Label Text="Define localised strings referenced by map scripts (map.str format)."
                   FontSize="12"
                   TextColor="{AppThemeBinding Light=#777, Dark=#999}" />
        </VerticalStackLayout>

        <!-- Add entry row -->
        <Grid Grid.Row="1" ColumnDefinitions="*,8,*,8,Auto" Margin="0,0,0,8">
            <Entry Grid.Column="0" x:Name="NewKeyEntry"
                   Placeholder="KEY (e.g. MAP:MyLabel)"
                   BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#333}" />
            <Entry Grid.Column="2" x:Name="NewValueEntry"
                   Placeholder="Value text"
                   BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#333}" />
            <Button Grid.Column="4" Text="Add" Clicked="OnAddEntry"
                    BackgroundColor="#007ACC" TextColor="White" WidthRequest="60" />
        </Grid>

        <CollectionView Grid.Row="2" x:Name="StringsView" SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,2" Padding="12,8"
                            BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#2D2D2D}"
                            Stroke="{AppThemeBinding Light=#DDD, Dark=#3F3F46}"
                            StrokeShape="RoundRectangle 4">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Key}" FontAttributes="Bold" FontFamily="Courier New"
                                       TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
                                <Label Text="{Binding Value}" FontSize="12"
                                       TextColor="{AppThemeBinding Light=#555, Dark=#AAA}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="✕" Clicked="OnDeleteEntry"
                                    CommandParameter="{Binding Key}"
                                    BackgroundColor="Transparent"
                                    TextColor="#CC4444" WidthRequest="32" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="3" ColumnDefinitions="*,12,*" Margin="0,12,0,0">
            <Button Grid.Column="0" Text="Cancel" Clicked="OnCancel"
                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                    TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
            <Button Grid.Column="2" Text="Apply" Clicked="OnApply"
                    BackgroundColor="#007ACC" TextColor="White" />
        </Grid>

    </Grid>
</ContentPage>

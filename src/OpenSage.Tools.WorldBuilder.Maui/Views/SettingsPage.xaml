<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OpenSage.Tools.WorldBuilder.Maui.Views.SettingsPage"
             Title="Settings"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#252525}">

    <Grid RowDefinitions="*,Auto" Padding="24">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16">

                <Label Text="Game Installation Paths"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#D4D4D4}" />

                <Label Text="Set the path to each game installation you want to edit maps for. Leave blank to skip that game."
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#555, Dark=#AAA}" />

                <!-- Generals -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#2D2D2D}"
                        Stroke="{AppThemeBinding Light=#DDD, Dark=#3F3F46}"
                        Padding="16" StrokeShape="RoundRectangle 6">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Command &amp; Conquer Generals" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
                        <Grid ColumnDefinitions="*,12,Auto">
                            <Entry Grid.Column="0" x:Name="GeneralsPathEntry"
                                   Placeholder="e.g. C:\Games\Generals"
                                   BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#333}" />
                            <Button Grid.Column="2" Text="Browse…"
                                    Clicked="OnBrowseGenerals"
                                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                                    TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Zero Hour -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#2D2D2D}"
                        Stroke="{AppThemeBinding Light=#DDD, Dark=#3F3F46}"
                        Padding="16" StrokeShape="RoundRectangle 6">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Command &amp; Conquer Generals: Zero Hour" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
                        <Grid ColumnDefinitions="*,12,Auto">
                            <Entry Grid.Column="0" x:Name="ZeroHourPathEntry"
                                   Placeholder="e.g. C:\Games\GeneralsZH"
                                   BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#333}" />
                            <Button Grid.Column="2" Text="Browse…"
                                    Clicked="OnBrowseZeroHour"
                                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                                    TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- BFME -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#2D2D2D}"
                        Stroke="{AppThemeBinding Light=#DDD, Dark=#3F3F46}"
                        Padding="16" StrokeShape="RoundRectangle 6">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="The Battle for Middle-earth" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
                        <Grid ColumnDefinitions="*,12,Auto">
                            <Entry Grid.Column="0" x:Name="BfmePathEntry"
                                   Placeholder="e.g. /Applications/BFME"
                                   BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#333}" />
                            <Button Grid.Column="2" Text="Browse…"
                                    Clicked="OnBrowseBfme"
                                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                                    TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,12,*" Margin="0,16,0,0">
            <Button Grid.Column="0" Text="Cancel" Clicked="OnCancel"
                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                    TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
            <Button Grid.Column="2" Text="Save" Clicked="OnSave"
                    BackgroundColor="#007ACC" TextColor="White" />
        </Grid>

    </Grid>
</ContentPage>

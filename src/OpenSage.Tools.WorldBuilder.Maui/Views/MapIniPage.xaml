<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OpenSage.Tools.WorldBuilder.Maui.Views.MapIniPage"
             Title="Map INI Editor"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#252525}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <Label Text="Map INI Editor" FontSize="18" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#D4D4D4}" />
            <Label Text="Edit the map.ini file that ships alongside this map."
                   FontSize="12"
                   TextColor="{AppThemeBinding Light=#777, Dark=#999}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light=#1E1E1E, Dark=#111}"
                Stroke="{AppThemeBinding Light=#DDD, Dark=#3F3F46}"
                StrokeShape="RoundRectangle 4">
            <Editor x:Name="IniEditor"
                    FontFamily="Courier New"
                    FontSize="13"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#D4D4D4, Dark=#D4D4D4}"
                    Placeholder="# Place map.ini overrides here&#x0a;# e.g. player color overrides, weather settings" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,12,*" Margin="0,12,0,0">
            <Button Grid.Column="0" Text="Cancel" Clicked="OnCancel"
                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                    TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
            <Button Grid.Column="2" Text="Apply" Clicked="OnApply"
                    BackgroundColor="#007ACC" TextColor="White" />
        </Grid>

    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OpenSage.Tools.WorldBuilder.Maui.Views.NewMapWizardPage"
             Title="New Map"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#252525}">

    <Grid RowDefinitions="*,Auto" Padding="24">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16">

                <Label Text="Create New Map"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#D4D4D4}" />

                <!-- Map dimensions -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#2D2D2D}"
                        Stroke="{AppThemeBinding Light=#DDD, Dark=#3F3F46}"
                        Padding="16" StrokeShape="RoundRectangle 6">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="Map Dimensions" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />

                        <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,8,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="Width (tiles)"
                                   TextColor="{AppThemeBinding Light=#555, Dark=#AAA}" FontSize="13" />
                            <Label Grid.Row="0" Grid.Column="2" Text="Height (tiles)"
                                   TextColor="{AppThemeBinding Light=#555, Dark=#AAA}" FontSize="13" />

                            <Entry Grid.Row="2" Grid.Column="0" x:Name="WidthEntry"
                                   Text="200" Keyboard="Numeric" MaxLength="4"
                                   BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#333}" />
                            <Entry Grid.Row="2" Grid.Column="2" x:Name="HeightEntry"
                                   Text="200" Keyboard="Numeric" MaxLength="4"
                                   BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#333}" />
                        </Grid>

                        <Label x:Name="DimensionsHint"
                               Text="Common sizes: 200×200, 300×300, 400×400, 500×500"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#888, Dark=#666}" />

                    </VerticalStackLayout>
                </Border>

                <!-- Initial height -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#2D2D2D}"
                        Stroke="{AppThemeBinding Light=#DDD, Dark=#3F3F46}"
                        Padding="16" StrokeShape="RoundRectangle 6">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="Initial Ground Height" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />

                        <Grid ColumnDefinitions="*,80">
                            <Slider x:Name="HeightSlider"
                                    Grid.Column="0"
                                    Minimum="0" Maximum="255" Value="50"
                                    ValueChanged="OnHeightSliderChanged" />
                            <Label x:Name="HeightValueLabel"
                                   Grid.Column="1"
                                   Text="50"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
                        </Grid>

                        <Label Text="Height range: 0 (sea level) to 255 (max elevation)"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#888, Dark=#666}" />

                    </VerticalStackLayout>
                </Border>

                <!-- Border width -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#2D2D2D}"
                        Stroke="{AppThemeBinding Light=#DDD, Dark=#3F3F46}"
                        Padding="16" StrokeShape="RoundRectangle 6">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="Border Width" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />

                        <Entry x:Name="BorderWidthEntry"
                               Text="6" Keyboard="Numeric" MaxLength="2"
                               BackgroundColor="{AppThemeBinding Light=#FFF, Dark=#333}" />

                        <Label Text="Number of non-playable tiles around the map border (default: 6)"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#888, Dark=#666}" />

                    </VerticalStackLayout>
                </Border>

                <!-- Validation error -->
                <Label x:Name="ValidationError"
                       IsVisible="false"
                       TextColor="#F44747"
                       FontSize="13" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Buttons row -->
        <Grid Grid.Row="1" ColumnDefinitions="*,12,*" Margin="0,16,0,0">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Clicked="OnCancel"
                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                    TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
            <Button Grid.Column="2"
                    Text="Create Map"
                    Clicked="OnCreate"
                    BackgroundColor="#007ACC"
                    TextColor="White" />
        </Grid>

    </Grid>

</ContentPage>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Override the global TargetFramework from Directory.Build.props -->
    <TargetFramework></TargetFramework>
    <!-- Build only for the current OS; MAUI requires platform-specific workloads -->
    <TargetPlatformMinVersion Condition="$([MSBuild]::IsOSPlatform('windows'))">10.0.19041.0</TargetPlatformMinVersion>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('macos'))">net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux'))">net10.0</TargetFrameworks>
    <!-- Compile as a plain library on Linux (no MAUI workload available) -->
    <UseMaui Condition="$([MSBuild]::IsOSPlatform('linux'))">false</UseMaui>
    <UseMaui Condition="!$([MSBuild]::IsOSPlatform('linux'))">true</UseMaui>
    <OutputType Condition="$([MSBuild]::IsOSPlatform('linux'))">Library</OutputType>
    <OutputType Condition="!$([MSBuild]::IsOSPlatform('linux'))">Exe</OutputType>
    <RootNamespace>OpenSage.Tools.WorldBuilder.Maui</RootNamespace>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Application identity -->
    <ApplicationTitle>OpenSAGE World Builder</ApplicationTitle>
    <ApplicationId>com.opensage.worldbuilder</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- Windows-specific packaging: unpackaged exe so game paths work -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- macOS entitlements for sandboxed file access -->
    <CodesignEntitlements Condition="$([MSBuild]::IsOSPlatform('macos'))">Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#1E1E1E" />
    <MauiFont Include="Resources\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="CommunityToolkit.Maui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSage.Tools.WorldBuilder.Core\OpenSage.Tools.WorldBuilder.Core.csproj" />
  </ItemGroup>

  <Target Name="_FixFontFallbackPublishFolderType" BeforeTargets="_ComputePublishLocation">
    <ItemGroup>
      <!-- Exclude this desktop-only config file from the MAUI app bundle -->
      <ResolvedFileToPublish Condition="'%(FileName)%(Extension)' == 'FontFallbackSettings.json'">
        <PublishFolderType>None</PublishFolderType>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>

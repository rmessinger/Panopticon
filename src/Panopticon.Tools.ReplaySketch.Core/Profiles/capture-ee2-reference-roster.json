{
  // WI-M2-03 reference roster publication (stock db.zip layer; patch archives reported, not
  // composed). Six installable rows publish beside Generals through the shared unit-content
  // layer; the seventh reference row, HeavyInfantry1UpgradeEpoch15 (infantry), is blocked on
  // Track C animation import (0x25 controller flags / legacy skinned clips) and is deliberately
  // absent: including it would fail visual verification and publish nothing.
  // Row keys are exact upgrade_unittypes.csv keys; each row's UNIT cell names the UnitType.
  // WI-M3-01 normalization (same derivation as ee2-reference-validation.json): EE2 NIF models
  // are authored in decimeters and one tile spans 50 model units; against Generals' audited
  // 3.6501 game units per meter (G10 Crusader hull anchor) one tile is 5 m = 18.2505 game
  // units and one model unit is 0.1 m = 0.36501 game units. Replaces the M2-era constant 12.
  // Run with:
  //   CNC_GENERALS_PATH=... EMPIRE_EARTH_II_PATH=... \
  //   dotnet run --project src/Panopticon.Tools.TestHarness -- --headless \
  //     --built-in-scenario ScenarioCapture --scenario capture-ee2-reference-roster.json
  "Name": "ee2-tank-rebel-duel",
  "MapPath": "maps/alpine assault/alpine assault.map",
  "DurationFrames": 360,
  "SettleFrames": 10,
  "CaptureStride": 1,
  "RenderEveryFrame": true,
  "HideHud": true,
  "Players": [
    { "Id": "ee2", "Side": "FactionAmerica", "Name": "EE2" },
    { "Id": "gla", "Side": "FactionGLA", "Name": "GLA" }
  ],
  "ContentImports": [
    {
      "Source": "ee2",
      "RowKeys": [
        "LightMounted1UpgradeEpoch15",
        "HeavyMounted1UpgradeEpoch15",
        "HeavyArtilleryUpgradeEpoch14",
        "FighterUpgradeEpoch15",
        "BomberUpgradeEpoch15",
        "LightMounted2UpgradeEpoch13"
      ],
      "Region": "we",
      // WI-M3-01: one EE2 tile is 50 decimeter model units = 5 m = 18.2505 Generals game units
      // (3.6501 units/m G10 anchor); see Ee2ReferenceScale for the full derivation.
      "GameUnitsPerSourceDistance": 18.2505,
      // WI-M3-01: one EE2 NIF model unit is 0.1 m = 0.36501 game units, folded into the draw's
      // world matrix so model extents, bones, and bounds match the converted gameplay scale.
      "GameUnitsPerSourceModelUnit": 0.36501,
      // Explicit Generals presentation compatibility, not source-authored EE2 effects.
      "DamageEffects": { "LightMounted1UpgradeEpoch15": "TankDamageFX" },
      // Tank shells select Generals tank-gun target effects; damage stays UNRESISTABLE.
      "ImpactEffectDamageTypes": { "LightMounted1UpgradeEpoch15": "ARMOR_PIERCING" },
      // WI-M3-02 rps -> Generals damage types: distinct engine-known types no native
      // Generals armor authors, so EE2 damage stays one-to-one against natives while
      // EE2-versus-EE2 resolves through the stock dbcombat matrix (see Ee2ReferenceRps).
      "RpsDamageTypes": {
        "Heavy_Infantry": "PIERCE",
        "Light_Mounted": "SLASH",
        "Heavy_Mounted": "SIEGE",
        "Heavy_Artillery": "BIG_ROCK",
        "Air_Superiority": "HERO_RANGED",
        "Bomber": "URUK",
        "Helicopter": "HERO"
      },
      "ExcludedMechanics": [
        "ownertype", "FootprintType", "SizeY", "mass", "popCount", "attributes", "nonAttributes", "stance",
        "Garrisonable", "Convertable", "ConvertAttack", "Cost", "GoesOnAirMissions", "visualName",
        "Attack.areaDamageFriendlyRatio", "Attack.angularRange", "Attack.turretControllerName", "Attack.ignoreBlocking",
        "Attack.attackOnTheMove", "Attack.WeaponType", "Attack.packTime", "Attack.unpackTime", "Attack.minRangeImmobile",
        "Attack.capture", "Attack.startWithNoOrdnance",
        "VehicleMove.followTerrainSlope", "VehicleMove.mustMoveToTurn", "VehicleMove.bounce",
        "AircraftMove.followTerrainSlope", "AircraftMove.mustMoveToTurn", "AircraftMove.ElevChangeRate",
        "AircraftMove.OnGroundScale", "AircraftMove.CargoHeight", "AircraftMove.accel",
        "Move.angAccel", "Move.bounce",
        "ProjectileMissileMove.type", "ProjectileMissileMove.accel", "ProjectileMissileMove.angSpeed",
        "Missile.PayloadAttack"
      ]
    }
  ],
  "Actors": [
    {
      "Id": "tank",
      "Label": "EE2 tank",
      "Definition": "ee2:LightMounted1UpgradeEpoch15",
      "Owner": "ee2",
      "X": 470,
      "Y": 700,
      "FacingDegrees": 0,
      "Role": "attacker"
    },
    {
      "Id": "rebel",
      "Label": "Generals Rebel",
      "Definition": "GLAInfantryRebel",
      "Owner": "gla",
      "X": 560,
      "Y": 700,
      "FacingDegrees": 180,
      "Role": "target"
    }
  ],
  "Camera": {
    "Mode": "AutoFit",
    "SubjectActorIds": [ "tank", "rebel" ],
    "DesiredSpanFraction": 0.35,
    "InitialCameraHeight": 220,
    "MinCameraHeight": 160,
    "MaxCameraHeight": 450
  },
  "Commands": [
    { "Type": "Attack", "Frame": 30, "SourceActorId": "tank", "TargetActorId": "rebel" },
    { "Type": "Attack", "Frame": 200, "SourceActorId": "rebel", "TargetActorId": "tank" }
  ],
  "Expectations": [
    { "Type": "ActorDamaged", "ActorId": "rebel" },
    { "Type": "ActorDamaged", "ActorId": "tank" }
  ],
  "StopWhenActorDestroyed": null
}

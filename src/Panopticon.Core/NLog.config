<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwExceptions="true">

  <extensions>
    <add assembly="Panopticon.Core"/>
  </extensions>

  <targets>
    <target name="file" xsi:type="File" fileName="${tempdir}panopticon.log" />
    <target name="console" xsi:type="ColoredConsole" layout="[${time}][${level}] ${message}"/>
    <target name="internal" xsi:type="Panopticon" layout="[${time}][${level}] ${message}"/>
  </targets>

  <rules>
    <logger name="Panopticon.Scripting.*" writeTo="" final="true"/>
    <logger name="Panopticon.Network.*" minlevel="Info" writeTo="console" final="true"/>
    <!-- Per-frame zoom/wheel trace (trackpad runaway-zoom repro). Set enabled="true" to write it to the log file. -->
    <logger name="Panopticon.Diagnostics.Zoom" level="Debug" writeTo="file" enabled="false" />
    <logger name="*" minlevel="Info" writeTo="console" />
    <logger name="*" minlevel="Info" writeTo="file" />
    <logger name="*" minlevel="Info" writeTo="internal" />
  </rules>
</nlog>
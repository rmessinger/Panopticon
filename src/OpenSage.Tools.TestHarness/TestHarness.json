{
  // TestHarness configuration
  // ------------------------------------
  // Scenario     : built-in scenario to run
  //                (AlpineAssaultUSAvGLA, AlpineAssaultUSAvGLAFullBuild, UnitValidationGround,
  //                 EngagementCapture); --built-in-scenario <name> overrides it
  // ScenarioPath : path to a scenario JSON profile, or null to use Scenario
  //                (ignored when Scenario is UnitValidationGround)
  // Game         : SAGE game to run (CncGenerals, CncGeneralsZeroHour, Bfme, Bfme2, Bfme2Rotwk)
  // Renderer     : graphics backend override, or null for platform default
  //                accepted values: Direct3D11, Vulkan, OpenGL, Metal, OpenGLES
  // Fullscreen   : start in fullscreen mode
  // Headless     : run without a window using an offscreen graphics device
  // CaptureFrames: in headless mode, save a PNG after every completed replay action
  //                (disabled by default)
  // KeepReplay   : keep the exported .rep file on disk after the run
  // GamePath     : override the game installation path (null = auto-detect)
  //
  // Unit Validation Ground (Scenario = UnitValidationGround) knobs, all optional with defaults:
  // ValidationGroundMapPath        : map override (default: Alpine Assault)
  // ValidationGroundSettleFrames   : frames to settle after spawn before ordering units
  // ValidationGroundBaselinePath   : golden baseline JSON (null/empty skips comparison)
  // ValidationGroundRefreshBaseline: true overwrites the baseline from the run instead of comparing
  // ValidationGroundReportPath     : where to write the JSON report artifact
  // ValidationGroundHoldOrders     : true (default) starts a windowed run paused with orders held;
  //                                  Space or the overlay button resumes (settle + attack orders),
  //                                  then toggles active pause. Ignored by headless runs.
  // ExitAfterTargetsDestroyed      : true (default) exits once all targets are destroyed/cap hit;
  //                                  false keeps the game running until the window is closed
  //                                  (windowed only; headless always exits)
  //
  // Engagement capture (Scenario = EngagementCapture) knobs live under "EngagementCapture";
  // all optional, see EngagementCaptureOptions. Headless only. Writes a PNG sequence plus a
  // manifest.json of per-frame actor projections; scripts/annotate_engagement_gif.py turns
  // those into an annotated GIF.

  "Scenario": "UnitValidationGround",
  "ScenarioPath": null,
  "Game": "CncGenerals",
  "Renderer": null,
  "Fullscreen": false,
  // FullHud: render the full control bar (buttons, money/power, background); false shows only the minimap
  "FullHud": false,
  "Headless": false,
  "CaptureFrames": false,
  "KeepReplay": false,
  "GamePath": null,
  "ValidationGroundHoldOrders": true,
  "ExitAfterTargetsDestroyed": false
}

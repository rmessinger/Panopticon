<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:OpenSage.Tools.ReplaySketch.Maui.Views"
             x:Class="OpenSage.Tools.ReplaySketch.Maui.MainPage"
             Title="OpenSAGE Replay Sketch"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}">

    <Grid RowDefinitions="*,Auto">

        <!-- Three-column work area: left=200 fixed, centre=* (largest), right=300 fixed -->
        <Grid Grid.Row="0"
              ColumnDefinitions="200,*,300"
              Margin="4,0">

            <!-- Left: scenario / player-slot editor -->
            <Border Grid.Column="0"
                    Stroke="{AppThemeBinding Light=#CCC, Dark=#444}"
                    BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}"
                    Padding="0"
                    Margin="2"
                    StrokeShape="RoundRectangle 4">
                <views:ScenarioView x:Name="ScenarioView"/>
            </Border>

            <!-- Centre: tab bar + action tree / map view -->
            <Grid Grid.Column="1"
                  RowDefinitions="Auto,*"
                  Margin="2">

                <!-- Tab bar -->
                <HorizontalStackLayout Grid.Row="0"
                                       Spacing="0"
                                       BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#2A2A2A}">
                    <Button x:Name="TreeTabBtn"
                            Text="Tree"
                            Clicked="OnTreeTabClicked"
                            FontSize="12"
                            Padding="16,6"
                            CornerRadius="0"
                            BorderWidth="0"
                            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}"
                            TextColor="{AppThemeBinding Light=#333, Dark=#EEE}"/>
                    <Button x:Name="MapTabBtn"
                            Text="Map"
                            Clicked="OnMapTabClicked"
                            FontSize="12"
                            Padding="16,6"
                            CornerRadius="0"
                            BorderWidth="0"
                            BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#2A2A2A}"
                            TextColor="{AppThemeBinding Light=#888, Dark=#888}"/>
                    <Button x:Name="ValidationGroundTabBtn"
                            Text="Validation Ground"
                            Clicked="OnValidationGroundTabClicked"
                            FontSize="12"
                            Padding="16,6"
                            CornerRadius="0"
                            BorderWidth="0"
                            BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#2A2A2A}"
                            TextColor="{AppThemeBinding Light=#888, Dark=#888}"/>
                    <Button x:Name="ModelTabBtn"
                            Text="Model"
                            Clicked="OnModelTabClicked"
                            FontSize="12"
                            Padding="16,6"
                            CornerRadius="0"
                            BorderWidth="0"
                            BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#2A2A2A}"
                            TextColor="{AppThemeBinding Light=#888, Dark=#888}"/>
                </HorizontalStackLayout>

                <!-- Content: tree view and map view share the same cell -->
                <Grid Grid.Row="1">
                    <Border x:Name="TreeFrame"
                            Stroke="{AppThemeBinding Light=#CCC, Dark=#444}"
                            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}"
                            Padding="0"
                            StrokeShape="RoundRectangle 0"
                            IsVisible="True">
                        <views:ActionTreeView x:Name="ActionTreeView"/>
                    </Border>
                    <Border x:Name="MapFrame"
                            Stroke="{AppThemeBinding Light=#CCC, Dark=#444}"
                            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}"
                            Padding="0"
                            StrokeShape="RoundRectangle 0"
                            IsVisible="False">
                        <views:MapPreviewView x:Name="MapPreviewView"/>
                    </Border>
                    <Border x:Name="ValidationGroundFrame"
                            Stroke="{AppThemeBinding Light=#CCC, Dark=#444}"
                            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}"
                            Padding="0"
                            StrokeShape="RoundRectangle 0"
                            IsVisible="False">
                        <views:ValidationGroundEditorView x:Name="ValidationGroundEditorView"/>
                    </Border>
                    <Border x:Name="ModelFrame"
                            Stroke="{AppThemeBinding Light=#CCC, Dark=#444}"
                            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}"
                            Padding="0"
                            StrokeShape="RoundRectangle 0"
                            IsVisible="False">
                        <views:ExternalModelView x:Name="ExternalModelView"/>
                    </Border>
                </Grid>

            </Grid>

            <!-- Right: detail panel for the selected action node -->
            <Border Grid.Column="2"
                    Stroke="{AppThemeBinding Light=#CCC, Dark=#444}"
                    BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}"
                    Padding="0"
                    Margin="2"
                    StrokeShape="RoundRectangle 4">
                <views:ActionDetailView x:Name="ActionDetail"/>
            </Border>

        </Grid>

        <!-- Bottom: validate / export / play strip -->
        <Border Grid.Row="1"
                Stroke="{AppThemeBinding Light=#CCC, Dark=#444}"
                BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}"
                Padding="0"
                Margin="4,2"
                StrokeShape="RoundRectangle 4">
            <views:ExportView x:Name="ExportView"/>
        </Border>

    </Grid>

</ContentPage>

<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="OpenSage.Tools.ReplaySketch.Maui.Views.MapPreviewView"
             x:Name="Root">
    <Grid>
        <skia:SKCanvasView x:Name="Canvas"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"
                           PaintSurface="OnPaintSurface"
                           Touch="OnCanvasTouch"
                           EnableTouchEvents="True"/>
        <!-- No-map overlay: shown when no map is loaded; hidden once map loads -->
        <VerticalStackLayout x:Name="NoMapOverlay"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="12"
                             MaximumWidthRequest="340"
                             Padding="24"
                             IsVisible="True">
            <Label x:Name="NoMapErrorLabel"
                   Text="No map loaded"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="#CCC"
                   FontSize="14"/>
            <Label Text="Generals installation folder:"
                   TextColor="#888"
                   FontSize="11"/>
            <Entry x:Name="InstallPathEntry"
                   Placeholder="e.g. /path/to/Generals"
                   PlaceholderColor="#555"
                   TextColor="#CCC"
                   BackgroundColor="#333"
                   FontSize="12"/>
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button Text="Browse…"
                        Clicked="OnBrowseClicked"
                        FontSize="12"
                        Padding="12,6"
                        CornerRadius="4"
                        BackgroundColor="#444"
                        TextColor="#CCC"/>
                <Button Text="Load"
                        Clicked="OnLoadClicked"
                        FontSize="12"
                        Padding="12,6"
                        CornerRadius="4"
                        BackgroundColor="#336699"
                        TextColor="White"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <HorizontalStackLayout HorizontalOptions="End"
                               VerticalOptions="End"
                               Margin="8"
                               Spacing="6">
            <Button x:Name="ZoomOutBtn"
                    Text="−"
                    Clicked="OnZoomOutClicked"
                    FontSize="14"
                    Padding="10,4"
                    CornerRadius="4"
                    BackgroundColor="#80333333"
                    TextColor="#CCC"/>
            <Button x:Name="ZoomInBtn"
                    Text="+"
                    Clicked="OnZoomInClicked"
                    FontSize="14"
                    Padding="10,4"
                    CornerRadius="4"
                    BackgroundColor="#80333333"
                    TextColor="#CCC"/>
            <Button x:Name="ResetZoomBtn"
                    Text="↺ Reset"
                    Clicked="OnResetZoomClicked"
                    FontSize="11"
                    Padding="8,4"
                    CornerRadius="4"
                    BackgroundColor="#80333333"
                    TextColor="#CCC"
                    IsVisible="False"/>
        </HorizontalStackLayout>
    </Grid>
</ContentView>

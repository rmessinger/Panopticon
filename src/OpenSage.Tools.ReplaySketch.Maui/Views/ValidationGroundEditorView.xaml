<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="OpenSage.Tools.ReplaySketch.Maui.Views.ValidationGroundEditorView"
             x:Name="Root">
    <Grid ColumnDefinitions="*,230">

        <!-- Map canvas -->
        <Grid Grid.Column="0">
            <skia:SKCanvasView x:Name="Canvas"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"
                               PaintSurface="OnPaintSurface"
                               Touch="OnCanvasTouch"
                               EnableTouchEvents="True"/>
            <HorizontalStackLayout HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   Margin="8"
                                   Spacing="6">
                <Button x:Name="MoveToolBtn"
                        Text="Move"
                        Clicked="OnMoveToolClicked"
                        FontSize="12"
                        Padding="12,6"
                        CornerRadius="4"
                        BackgroundColor="#336699"
                        TextColor="White"/>
                <Button x:Name="PanToolBtn"
                        Text="Pan"
                        Clicked="OnPanToolClicked"
                        FontSize="12"
                        Padding="12,6"
                        CornerRadius="4"
                        BackgroundColor="#80333333"
                        TextColor="#CCC"/>
                <Label x:Name="HintLabel"
                       Text="Move: drag a marker to reposition"
                       TextColor="#AAA"
                       FontSize="11"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout HorizontalOptions="End"
                                   VerticalOptions="End"
                                   Margin="8"
                                   Spacing="6">
                <Button Text="−"
                        Clicked="OnZoomOutClicked"
                        FontSize="14"
                        Padding="10,4"
                        CornerRadius="4"
                        BackgroundColor="#80333333"
                        TextColor="#CCC"/>
                <Button Text="+"
                        Clicked="OnZoomInClicked"
                        FontSize="14"
                        Padding="10,4"
                        CornerRadius="4"
                        BackgroundColor="#80333333"
                        TextColor="#CCC"/>
                <Button Text="↺ Reset"
                        Clicked="OnResetZoomClicked"
                        FontSize="11"
                        Padding="8,4"
                        CornerRadius="4"
                        BackgroundColor="#80333333"
                        TextColor="#CCC"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Knobs + actions panel -->
        <ScrollView Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}">
            <VerticalStackLayout Padding="10" Spacing="8">

                <Label Text="Layout knobs"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#333, Dark=#EEE}"/>

                <Grid ColumnDefinitions="*,70" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <Label Grid.Row="0" Grid.Column="0" Text="Centre X" VerticalOptions="Center" FontSize="11" TextColor="{AppThemeBinding Light=#444, Dark=#BBB}"/>
                    <Entry x:Name="ClusterXEntry" Grid.Row="0" Grid.Column="1" Keyboard="Numeric" FontSize="12"/>
                    <Label Grid.Row="1" Grid.Column="0" Text="Centre Y" VerticalOptions="Center" FontSize="11" TextColor="{AppThemeBinding Light=#444, Dark=#BBB}"/>
                    <Entry x:Name="ClusterYEntry" Grid.Row="1" Grid.Column="1" Keyboard="Numeric" FontSize="12"/>
                    <Label Grid.Row="2" Grid.Column="0" Text="Unit spacing" VerticalOptions="Center" FontSize="11" TextColor="{AppThemeBinding Light=#444, Dark=#BBB}"/>
                    <Entry x:Name="UnitSpacingEntry" Grid.Row="2" Grid.Column="1" Keyboard="Numeric" FontSize="12"/>
                    <Label Grid.Row="3" Grid.Column="0" Text="Faction row gap" VerticalOptions="Center" FontSize="11" TextColor="{AppThemeBinding Light=#444, Dark=#BBB}"/>
                    <Entry x:Name="FactionRowOffsetEntry" Grid.Row="3" Grid.Column="1" Keyboard="Numeric" FontSize="12"/>
                    <Label Grid.Row="4" Grid.Column="0" Text="Unit-target gap" VerticalOptions="Center" FontSize="11" TextColor="{AppThemeBinding Light=#444, Dark=#BBB}"/>
                    <Entry x:Name="TargetApproachEntry" Grid.Row="4" Grid.Column="1" Keyboard="Numeric" FontSize="12"/>
                </Grid>

                <Button Text="Regenerate from knobs"
                        Clicked="OnRegenerateClicked"
                        FontSize="12"
                        Padding="10,6"
                        CornerRadius="4"
                        BackgroundColor="#336699"
                        TextColor="White"/>

                <Label Text="Scenario file"
                       FontSize="13"
                       FontAttributes="Bold"
                       Margin="0,8,0,0"
                       TextColor="{AppThemeBinding Light=#333, Dark=#EEE}"/>
                <HorizontalStackLayout Spacing="6">
                    <Button Text="Load…"
                            Clicked="OnLoadClicked"
                            FontSize="12"
                            Padding="10,6"
                            CornerRadius="4"
                            BackgroundColor="#444"
                            TextColor="#CCC"/>
                    <Button Text="Save…"
                            Clicked="OnSaveClicked"
                            FontSize="12"
                            Padding="10,6"
                            CornerRadius="4"
                            BackgroundColor="#444"
                            TextColor="#CCC"/>
                </HorizontalStackLayout>

                <Label x:Name="StatusLabel"
                       Text=""
                       FontSize="11"
                       TextColor="#888"/>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentView>

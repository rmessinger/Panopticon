<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="OpenSage.Tools.ReplaySketch.Maui.Views.ActionTreeView"
             x:Name="Root">

    <Grid>

        <!-- Tree area: palette (left) + canvas (right) -->
        <Grid ColumnDefinitions="104,*">

            <!-- Left: action type palette -->
            <Border Grid.Column="0"
                    Stroke="{AppThemeBinding Light=#CCC, Dark=#444}"
                    BackgroundColor="{AppThemeBinding Light=#F4F4F4, Dark=#222222}"
                    StrokeShape="Rectangle"
                    Padding="0">
                <ScrollView>
                    <VerticalStackLayout x:Name="PalettePanel"
                                         Padding="6" Spacing="4"/>
                </ScrollView>
            </Border>

            <!-- Right: SkiaSharp tree canvas; touch events used for node selection -->
            <skia:SKCanvasView Grid.Column="1"
                               x:Name="TreeCanvas"
                               PaintSurface="OnPaintSurface"
                               Touch="OnCanvasTouch"
                               EnableTouchEvents="True"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"/>

        </Grid>

        <!-- Add-Action flyout overlay — covers entire view, hidden by default -->
        <Grid x:Name="FlyoutOverlay" IsVisible="False">
            <!-- Semi-transparent backdrop; tap to dismiss -->
            <BoxView x:Name="FlyoutBackdrop" BackgroundColor="#80000000" InputTransparent="False"/>
            <!-- Flyout card -->
            <Border x:Name="FlyoutCard"
                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}"
                    Stroke="{AppThemeBinding Light=#555, Dark=#666}"
                    StrokeShape="RoundRectangle 8"
                    Padding="16"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    MinimumWidthRequest="280">
                <VerticalStackLayout x:Name="FlyoutContent" Spacing="8"/>
            </Border>
        </Grid>

    </Grid>
</ContentView>

<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="OpenSage.Tools.ReplaySketch.Maui.Views.ActionTreeView"
             x:Name="Root">

    <Grid>

        <!-- Tree area: palette (left) + canvas (right) -->
        <Grid ColumnDefinitions="104,*">

            <!-- Left: action type palette -->
            <Border Grid.Column="0"
                    Stroke="{AppThemeBinding Light=#CCC, Dark=#444}"
                    BackgroundColor="{AppThemeBinding Light=#F4F4F4, Dark=#222222}"
                    StrokeShape="Rectangle"
                    Padding="0">
                <ScrollView>
                    <VerticalStackLayout x:Name="PalettePanel"
                                         Padding="6" Spacing="4"/>
                </ScrollView>
            </Border>

            <!-- Right: SkiaSharp tree canvas; touch events used for node selection -->
            <skia:SKCanvasView Grid.Column="1"
                               x:Name="TreeCanvas"
                               PaintSurface="OnPaintSurface"
                               Touch="OnCanvasTouch"
                               EnableTouchEvents="True"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"/>

        </Grid>

    </Grid>
</ContentView>

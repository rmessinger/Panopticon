{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/Panopticon.Launcher/Panopticon.Launcher.csproj"
            ],
            "problemMatcher": "$tsc"
        },
        {
            "label": "build-testharness",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/Panopticon.Tools.TestHarness/Panopticon.Tools.TestHarness.csproj"
            ],
            "problemMatcher": "$tsc"
        },
        {
            "label": "build-testharness-all",
            "dependsOn": ["build", "build-testharness"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "build-replaysketch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/Panopticon.Tools.ReplaySketch.Avalonia/Panopticon.Tools.ReplaySketch.Avalonia.csproj"
            ],
            "problemMatcher": "$tsc"
        },
        {
            "label": "build-harness-configurator",
            "dependsOn": ["build-testharness-all", "build-replaysketch"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/src/Panopticon.Launcher/Panopticon.Launcher.csproj"
            ],
            "problemMatcher": "$tsc"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "${workspaceFolder}/src/Panopticon.Launcher/Panopticon.Launcher.csproj"
            ],
            "problemMatcher": "$tsc"
        }
    ]
}
{
   // Use IntelliSense to find out which attributes exist for C# debugging
   // Use hover for the description of the existing attributes
   // For further information visit https://github.com/OmniSharp/omnisharp-vscode/blob/master/debugger-launchjson.md
   "version": "0.2.0",
   "configurations": [
        {
            "name": "Generals",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/Panopticon.Launcher/bin/Debug/net10.0/Panopticon.Launcher.dll",
            "args": [
                "--game", "0"
            ]
        },
        {
          "name": "Generals (Alpine Assault)",
          "type": "coreclr",
          "request": "launch",
          "program": "${workspaceFolder}/src/Panopticon.Launcher/bin/Debug/net10.0/Panopticon.Launcher.dll",
          "args": [
              "--game", "0",
              "--map", "maps\\Alpine Assault\\Alpine Assault.map"
          ]
        },
        {
          "name": "Generals (Tournament Island)",
          "type": "coreclr",
          "request": "launch",
          "program": "${workspaceFolder}/src/Panopticon.Launcher/bin/Debug/net10.0/Panopticon.Launcher.dll",
          "args": [
              "--game", "0",
              "--map", "maps\\Tournament Island\\Tournament Island.map"
          ]
        },
        // TestHarness scenario is selected by the "Scenario" field in
        // src/Panopticon.Tools.TestHarness/TestHarness.json (copied to the output dir on build).
        // Valid BuiltInScenario values:
        //   AlpineAssaultUSAvGLA
        //   AlpineAssaultUSAvGLAFullBuild
        //   UnitValidationGround
        //   EngagementCapture
        //   ScenarioCapture
        // The Scenario field is the single toggle; ScenarioPath/--scenario only overrides the map
        // for the two replay scenarios and is ignored when Scenario is UnitValidationGround.
        // --built-in-scenario/--scenario (see the ScenarioCapture config below) override both
        // fields for a single run without touching TestHarness.json.
        {
            "name": "TestHarness",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/Panopticon.Tools.TestHarness/bin/Debug/net10.0/Panopticon.Tools.TestHarness.dll",
            "preLaunchTask": "build-testharness-all"
        },
        {
            "name": "TestHarness (Headless)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/Panopticon.Tools.TestHarness/bin/Debug/net10.0/Panopticon.Tools.TestHarness.dll",
            "args": ["--headless"],
            "preLaunchTask": "build-testharness-all"
        },
        {
            // Runs the generic ScenarioCapture profile named in the last --scenario argument;
            // swap it for another embedded profile name (e.g. capture-impulse.json) or a path to
            // your own capture profile JSON. See docs/screenshots.md and
            // src/Panopticon.Tools.TestHarness/AGENTS.md for the profile schema.
            "name": "TestHarness (ScenarioCapture)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/Panopticon.Tools.TestHarness/bin/Debug/net10.0/Panopticon.Tools.TestHarness.dll",
            "args": ["--headless", "--built-in-scenario", "ScenarioCapture", "--scenario", "capture-construction.json"],
            "preLaunchTask": "build-testharness-all"
        },
        {
            "name": "ReplaySketch",
            "type": "maui",
            "request": "launch",
            "preLaunchTask": "maui: Build"
        },
        {
            "name": "WorldBuilder",
            "type": "maui",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/Panopticon.Tools.WorldBuilder.Maui/Panopticon.Tools.WorldBuilder.Maui.csproj",
            "preLaunchTask": "maui: Build"
        },
        {
            "name": "Zero Hour",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/Panopticon.Launcher/bin/Debug/net10.0/Panopticon.Launcher.dll",
            "args": [
                "--game", "1"
            ]
        }
    ]
}

        {
            "name": "WorldBuilder",
            "type": "maui",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/OpenSage.Tools.WorldBuilder.Maui/OpenSage.Tools.WorldBuilder.Maui.csproj",
            "preLaunchTask": "maui: Build"
        },
        {
            "name": "Zero Hour",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/OpenSage.Launcher/bin/Debug/net10.0/OpenSage.Launcher.dll",
            "args": [
                "--game", "1"
            ]
        }

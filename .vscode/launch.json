   "version": "0.2.0",
   "configurations": [
        {
            "name": "Generals",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/OpenSage.Launcher/bin/Debug/net10.0/OpenSage.Launcher.dll",
            "args": [
                "--game", "0"
            ]
        },
        {
          "name": "Generals (Alpine Assault)",
          "type": "coreclr",
          "request": "launch",
          "program": "${workspaceFolder}/src/OpenSage.Launcher/bin/Debug/net10.0/OpenSage.Launcher.dll",
          "args": [
              "--game", "0",
              "--map", "maps\\Alpine Assault\\Alpine Assault.map"
          ]
        },
        {
          "name": "Generals (Tournament Island)",
          "type": "coreclr",
          "request": "launch",
          "program": "${workspaceFolder}/src/OpenSage.Launcher/bin/Debug/net10.0/OpenSage.Launcher.dll",
          "args": [
              "--game", "0",
              "--map", "maps\\Tournament Island\\Tournament Island.map"
          ]
        },
        {
            "name": "TestHarness",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/OpenSage.Tools.TestHarness/bin/Debug/net10.0/OpenSage.Tools.TestHarness.dll",
            "preLaunchTask": "build"
        },
        {
            "name": "TestHarness (Headless)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/OpenSage.Tools.TestHarness/bin/Debug/net10.0/OpenSage.Tools.TestHarness.dll",
            "args": ["--headless"],
            "preLaunchTask": "build"
        },
        {
            "name": "ReplaySketch",
            "type": "maui",
            "request": "launch",
            "preLaunchTask": "maui: Build"

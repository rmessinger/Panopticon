      "derived": "produced using Copernicus WorldDEM-30 © DLR e.V. 2010-2014 and © Airbus Defence and Space GmbH 2014-2018 provided under COPERNICUS by the European Union and ESA; all rights reserved",
      "liability": "The organisations in charge of the Copernicus programme by law or by delegation do not incur any liability for any use of the Copernicus WorldDEM-30"
    },
    "imagery": {
      "source": "Copernicus Sentinel data [Year]",
      "derived": "Contains modified Copernicus Sentinel data [Year]"
    }
  },
  "manifestRequirements": {
    "target": "utm",
    "zoneRange": [1, 60],
    "hemisphereRequired": true,
    "verticalDatumPassthrough": true,
    "tolerances": {
      "verticalMeters": {
        "required": true,
        "schemaValue": 1.0,
        "schemaValueSemantics": "validation-parameter-not-accuracy-not-evaluated-no-PASS-no-4m-from-LE90"
      }
    },
    "controlPoints": {
      "required": false,
      "noneForCopernicus": true
    },
    "rasterPolicy": {
      "noData": "nearest-valid",
      "radiusMeters": 3.048,
      "edgePolicy": "fail"
    },
    "imageryPixelsPerSample": 10
  }
